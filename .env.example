# Скопируйте этот файл в .env, заполните значения и закройте его от других пользователей сервера:
#   cp .env.example .env
#   chmod 600 .env
# В .env хранятся пароли — не публикуйте его и не добавляйте в git.

# ===== Обязательно =====

# Домен сайта. Несколько — через запятую: example.ru, www.example.ru
# Для проверки на своем компьютере: localhost — сайт будет на https://localhost
# (не на http://127.0.0.1:8000 — в Docker наружу открыт только Caddy на портах 80/443)
DOMAIN=example.ru

# Секретный ключ Django — длинная случайная строка. Сгенерировать:
#   openssl rand -base64 48
DJANGO_SECRET_KEY=

# Пароль базы данных. Не придумывайте его — сгенерируйте:
#   openssl rand -hex 24
# ВАЖНО: пароль применяется только при самом первом запуске, когда создается база.
# Если потом поменять его здесь, сайт перестанет подключаться к базе.
# Как сменить пароль правильно — в README, раздел «Безопасность».
POSTGRES_PASSWORD=

# Пароль шифрования резервных копий. Сгенерируйте:
#   openssl rand -base64 32
# ОБЯЗАТЕЛЬНО сохраните его в менеджере паролей или другом надежном месте вне сервера:
# без него зашифрованные копии восстановить невозможно — никто, включая разработчиков, не поможет.
# Без этого пароля копии не шифруются и не загружаются на Яндекс Диск.
# Если пароль сменить, старые копии по-прежнему открываются только старым паролем.
BACKUP_ENCRYPTION_PASSWORD=

# ===== Первый администратор (создается при первом запуске) =====
# Не используйте очевидные логины вроде admin или administrator.
# Пароль — не короче 12 символов. После первого входа смените его в админ-панели
# и удалите из этого файла: повторно администратор не создается, строка больше не нужна.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# ===== TeamSpeak 3 (обязательно) =====
# Голосовой сервер с готовыми комнатами гильдии и бот (tsbot/channels.json). Подробнее — docs/GUIDE.md, раздел «TeamSpeak».
# Запускает сервер TeamSpeak и бота вместе с сайтом — не удаляйте
COMPOSE_PROFILES=teamspeak
# Впишите accept — это значит, что вы принимаете лицензию TeamSpeak. Прочитать её:
#   docker run --rm -e TS3SERVER_LICENSE=view teamspeak:3.13
TS3SERVER_LICENSE=
# Пароль ServerQuery — им бот управляет сервером TeamSpeak: openssl rand -hex 16
TS3_SERVERADMIN_PASSWORD=
# Ключ, которым бот входит в API сайта: openssl rand -hex 32
TSBOT_API_TOKEN=

# Почта, подтверждение регистрации по email и капча настраиваются в админ-панели:
# Настройки сайта → «Регистрация», «Почта (SMTP)», «Капча DDoS-Guard».

# ===== Необязательно =====
# Имя базы и пользователя базы — не секрет: порт базы закрыт снаружи,
# к ней подключаются только контейнеры сайта. Менять можно только до первого запуска
POSTGRES_DB=forum
POSTGRES_USER=forum
# Число процессов gunicorn (примерно 2 × ядра процессора + 1)
GUNICORN_WORKERS=3
