# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env

# ===== Обязательно =====

# Домен сайта. Несколько — через запятую: example.ru, www.example.ru
# Для проверки на своем компьютере: localhost — сайт будет на https://localhost
# (не на http://127.0.0.1:8000 — в Docker наружу открыт только Caddy на портах 80/443)
DOMAIN=example.ru

# Секретный ключ Django — длинная случайная строка. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Пароль базы данных. Используйте только латинские буквы и цифры
POSTGRES_PASSWORD=

# ===== Первый администратор (создается при первом запуске) =====
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# ===== Регистрация: Google reCAPTCHA (https://www.google.com/recaptcha/admin) =====
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=

# ===== Почта для писем подтверждения регистрации =====
# Пример для Яндекса: EMAIL_HOST=smtp.yandex.ru, EMAIL_PORT=465, EMAIL_USE_TLS=False, EMAIL_USE_SSL=True
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# ===== Необязательно =====
POSTGRES_DB=forum
POSTGRES_USER=forum
# Число процессов gunicorn (примерно 2 × ядра процессора + 1)
GUNICORN_WORKERS=3
